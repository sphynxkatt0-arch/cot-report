    {
      "key": "repo_dvp_volume",
      "label": "DVP overnight/open transaction volume",
      "dataset": "repo",
      "unit": "USD bn",
      "scale_divisor": 1000000000,
      "preferred_mnemonics": ["REPO-DVP_TV_OO-P"],
      "search_query": "DVP*Transaction Volume*Overnight*",
      "include_terms": ["dvp", "transaction volume", "overnight"],
      "exclude_terms": ["rate", "30 days", "disclosure"],
      "minimum_match_score": 5,
      "stale_after_days": 5,
      "short_observations": 5,
      "medium_observations": 20
    },
    {
