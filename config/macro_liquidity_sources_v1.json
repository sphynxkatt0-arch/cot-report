{
  "schema_version": 1,
  "description": "Official OFR STFM series used by the macro-liquidity control room. Preferred mnemonics are definition-reviewed current series; metadata search is the fallback.",
  "indicators": [
    {
      "key": "repo_dvp_rate",
      "label": "DVP overnight/open repo rate",
      "dataset": "repo",
      "unit": "%",
      "preferred_mnemonics": ["REPO-DVP_AR_OO-P"],
      "search_query": "DVP Service Average Rate*Overnight*",
      "include_terms": ["dvp", "average rate", "overnight"],
      "exclude_terms": ["volume", "30 days", "disclosure"],
      "stale_after_days": 5,
      "short_observations": 5,
      "medium_observations": 20
    },
    {
      "key": "repo_gcf_rate",
      "label": "GCF overnight/open repo rate",
      "dataset": "repo",
      "unit": "%",
      "preferred_mnemonics": ["REPO-GCF_AR_OO-P"],
      "search_query": "GCF*Average Rate*Overnight*",
      "include_terms": ["gcf", "average rate", "overnight"],
      "exclude_terms": ["volume", "30 days", "disclosure"],
      "stale_after_days": 5,
      "short_observations": 5,
      "medium_observations": 20
    },
    {
      "key": "repo_triparty_rate",
      "label": "Tri-party overnight/open repo rate",
      "dataset": "repo",
      "unit": "%",
      "preferred_mnemonics": ["REPO-TRI_AR_OO-P"],
