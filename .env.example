# ─────────────────────────────────────────────────────────────────────────────
# COT Dashboard – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Alternatively, place your FRED key in  analysis/config/fred_api_key.txt
# ─────────────────────────────────────────────────────────────────────────────

# Federal Reserve Economic Data (FRED) API key
# Get yours free at: https://fred.stlouisfed.org/docs/api/api_key.html
# Optional – the pipeline has fallback data sources if this is missing.
FRED_API_KEY=your_fred_api_key_here
